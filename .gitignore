# Local .terraform directories
**/.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
# *.tfvars
# *.tfvars.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# SSH keys and secret files
*.pem
*.key
*.pub

# Temp and scratch directories
scratch/
tmp/
.ds_store
Thumbs.db
