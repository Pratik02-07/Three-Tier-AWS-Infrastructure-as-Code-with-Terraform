aws_region                = "us-east-1"
environment               = "prod"
frontend_instance_type    = "t3.small"
backend_instance_type     = "t3.small"
frontend_min_size         = 2
frontend_max_size         = 6
frontend_desired_capacity = 4
backend_min_size          = 2
backend_max_size          = 6
backend_desired_capacity  = 4
db_instance_class         = "db.t3.small"
db_allocated_storage      = 50
db_name                   = "proddb"
db_username               = "prodadmin"
db_password               = "ProdStrictPassword123!"
db_multi_az               = true